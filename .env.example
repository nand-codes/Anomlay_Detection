# Copy to .env and adjust if needed:
#   copy .env.example .env

# Redpanda image tags (pinned for reproducible local setup)
REDPANDA_VERSION=v26.2.1
REDPANDA_CONSOLE_VERSION=v3.9.0

# Host-mapped ports
KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8080
REDPANDA_ADMIN_PORT=19644
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PANDAPROXY_PORT=18082

# Kafka bootstrap for host-side clients (kpi-simulator later)
KAFKA_BOOTSTRAP=localhost:19092

# Topic used by the KPI simulator
KPI_TOPIC=kpis.raw
KPI_TOPIC_PARTITIONS=12
# Redpanda buffer retention — set via config.yaml (default = interval_sec * 1000, 15 min)
KPI_TOPIC_RETENTION_MS=900000

# KPI simulator (Part B) — interval-based site-level KPIs (see config.yaml)
INTERVAL_SEC=900
ALIGN_TO_BOUNDARY=true
FAULT_INJECTION_RATE=0.05
FAULT_DURATION_SEC=3600
KPI_SIMULATOR_METRICS_PORT=9100

# TimescaleDB (Part C)
TIMESCALE_VERSION=latest-pg16
POSTGRES_USER=netintel
POSTGRES_PASSWORD=netintel
POSTGRES_DB=netintel
POSTGRES_PORT=5432
DATABASE_URL=postgresql://netintel:netintel@localhost:5432/netintel

# Ingest worker (Part C)
CONSUMER_GROUP=ingest-worker
INGEST_BATCH_SIZE=500
INGEST_METRICS_PORT=9101

# Dashboard
DASHBOARD_PORT=8088
